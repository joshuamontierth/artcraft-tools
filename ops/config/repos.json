{
  "_comment": "Single source of truth for the ArtCraft ops scripts (Windows and Linux). Paths are relative to the workspace root (the folder that holds the repos and ops/). Control ports are made unique per app so several apps can run at once (upstream defaults collide on 7979).",
  "repos": [
    {
      "name": "photocraft",
      "title": "PhotoCraft",
      "adobe": "Adobe Photoshop",
      "url": "https://github.com/storytold/photocraft.git",
      "branch": "main",
      "build_packages": [
        "photocraft",
        "photocraft-cli"
      ],
      "gui_exe": "photocraft",
      "cli_exe": "photocraft-cli",
      "control_port": 7878,
      "token_file": true,
      "gui_args": [
        "--control",
        "{port}",
        "--control-token-file",
        "{token_file}",
        "--automation-read-root",
        "{work_dir}",
        "--automation-write-root",
        "{work_dir}"
      ],
      "mcp_live_args": [
        "mcp",
        "--bridge",
        "127.0.0.1:{port}",
        "--control-token-file",
        "{token_file}"
      ],
      "mcp_headless_args": [
        "mcp",
        "--automation-read-root",
        "{work_dir}",
        "--automation-write-root",
        "{work_dir}"
      ],
      "course": true
    },
    {
      "name": "lightcraft",
      "title": "LightCraft",
      "adobe": "Adobe Lightroom Classic",
      "url": "https://github.com/storytold/lightcraft.git",
      "branch": "main",
      "build_packages": [
        "lightcraft",
        "lightcraft-cli"
      ],
      "gui_exe": "lightcraft",
      "cli_exe": "lightcraft-cli",
      "control_port": 7980,
      "token_file": false,
      "gui_args": [
        "--control",
        "{port}"
      ],
      "mcp_live_args": [
        "mcp",
        "--connect",
        "127.0.0.1:{port}"
      ],
      "mcp_headless_args": [
        "mcp",
        "{work_dir}"
      ],
      "course": true
    },
